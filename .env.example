# Copia este archivo a .env y ajusta los valores.
# NUNCA subas el archivo .env real al repositorio.

APP_NAME=SuperFlash Monitor
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO

# Conexión a PostgreSQL (driver psycopg 3).
# Con Docker Compose el host es "db"; en local suele ser "localhost".
DATABASE_URL=postgresql+psycopg://superflash:changeme@localhost:5432/superflash

# Adaptador que alimenta la recolección: "mock" (combinado histórico) o
# "composite" (une las fuentes por tipo de abajo).
MONITORING_ADAPTER=mock
# Semilla del generador de datos simulados (reproducibilidad).
MOCK_SEED=42

# Fuentes por tipo (usadas por "composite" y por el comando de
# diagnóstico python -m app.tasks.diagnose_source). Por ahora solo "mock";
# las fuentes reales se registrarán aquí (p. ej. prometheus, netdata,
# panel) leyendo sus credenciales de variables de entorno dedicadas.
INFRASTRUCTURE_SOURCE=mock
STREAMING_SOURCE=mock

# Clave requerida por POST /api/v1/collection/run (cabecera X-API-Key).
# Sin clave configurada el endpoint se niega a operar (fail-closed).
# Genera una propia, p. ej.: python -c "import secrets; print(secrets.token_urlsafe(32))"
COLLECTION_API_KEY=

# Recolección periódica automática (cada COLLECTION_INTERVAL_SECONDS).
# Deshabilitada por defecto; actívala solo con una única instancia de la API.
SCHEDULER_ENABLED=false
COLLECTION_INTERVAL_SECONDS=300

# Orígenes CORS permitidos, separados por coma. Vacío = CORS deshabilitado.
# Nunca uses "*" en producción.
CORS_ORIGINS=

# Variables usadas solo por docker-compose (credenciales de desarrollo).
POSTGRES_USER=superflash
POSTGRES_PASSWORD=changeme
POSTGRES_DB=superflash
POSTGRES_PORT=5432
API_PORT=8000
