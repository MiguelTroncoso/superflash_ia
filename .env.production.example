# Copia este archivo como .env.production y reemplaza los valores marcados.
# Nunca subas .env.production al repositorio. Usa valores generados de forma
# aleatoria y conserva el archivo con permisos 600.

COMPOSE_PROJECT_NAME=superflash-monitor

APP_NAME=SuperFlash Monitor
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# El compose de producción fuerza APP_ENV=production.
# La fase inicial continúa usando datos simulados y solo lectura.
MONITORING_ADAPTER=mock
INFRASTRUCTURE_SOURCE=mock
STREAMING_SOURCE=mock
MOCK_SEED=42

# Nginx es el único puerto publicado por la stack.
HTTP_PORT=80

# Genera el password con, por ejemplo: openssl rand -hex 32
# Un valor hexadecimal evita caracteres que deban escaparse en DATABASE_URL.
POSTGRES_USER=superflash
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_HEX_PASSWORD
POSTGRES_DB=superflash

# Genera una clave independiente con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=REPLACE_WITH_A_LONG_RANDOM_API_KEY

# El scheduler es de proceso único; mantenlo activo solo con una instancia API.
SCHEDULER_ENABLED=true
COLLECTION_INTERVAL_SECONDS=300
COLLECTION_TIMEOUT_SECONDS=600

# Canales dinámicos: no se eliminan al desaparecer de Xtream.
EVENT_INACTIVE_GRACE_HOURS=6
EVENT_ARCHIVE_DAYS=7
PERMANENT_ARCHIVE_DAYS=30

# Retención deshabilitada por defecto. Si se define, la limpieza sigue siendo
# un comando explícito: python -m app.tasks.prune_metrics --dry-run.
METRICS_RETENTION_DAYS=

# CORS vacío: el dashboard todavía no forma parte de esta fase.
CORS_ORIGINS=

# Reservado para una fuente futura; no agregues endpoints ni credenciales reales
# hasta completar la fase de integración de infraestructura.
PROMETHEUS_URL=
PROMETHEUS_TIMEOUT_SECONDS=10
PROMETHEUS_BEARER_TOKEN=
PROMETHEUS_TLS_VERIFY=true
INFRASTRUCTURE_INVENTORY_FILE=
